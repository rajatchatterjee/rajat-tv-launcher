<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Required for apps targeting API 26+ to trigger the system
         uninstall-confirmation flow (what bulk uninstall relies on).
         Without this, Intent.ACTION_DELETE silently does nothing. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- For the weather widget: INTERNET to call the weather API,
         ACCESS_COARSE_LOCATION (requested at runtime) so the forecast
         matches where the TV actually is rather than a hardcoded city. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Normal (install-time) permission: lets the top bar show whether the
         TV is on Wi-Fi, Ethernet, or offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Self-update from GitHub Releases (data/Updater.kt). The user allows
         "Install unknown apps" for the launcher once; each update then needs
         just one "Install" press, no Downloader app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Settings › Diagnostics: lets the launcher *attempt* to read the TV
         provider (channels / preview programs / Watch Next) to show whether
         this TV exposes other apps' preview rows. "normal" protection level
         (and no longer enforced on newer Android), so it adds no install
         prompt and can't cause "App not installed". -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <!-- Modern (non-sensitive) replacement for QUERY_ALL_PACKAGES: tells
         Android exactly which other apps we need to see — anything with
         a TV or phone/tablet launcher entry point — without requesting
         broad visibility into every package on the device. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Diagnostics: see the TV provider and the settings apps so the
             developer-options shortcuts can be resolved on Android 11+. -->
        <provider android:authorities="android.media.tv" />
        <package android:name="com.android.tv.settings" />
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyTVLauncher"
        android:supportsRtl="true">

        <!-- Main home screen activity.
             The HOME + DEFAULT category combo is what lets Android TV
             offer this app as a selectable launcher. LEANBACK_LAUNCHER
             is what makes it show up correctly on Android TV at all. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyTVLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.UpdateStatusReceiver"
            android:exported="false" />

    </application>
</manifest>
