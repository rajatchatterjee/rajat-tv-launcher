<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Required for apps targeting API 26+ to trigger the system
         uninstall-confirmation flow (what bulk uninstall relies on).
         Without this, Intent.ACTION_DELETE silently does nothing. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- For the weather widget: INTERNET to call the weather API,
         ACCESS_COARSE_LOCATION (requested at runtime) so the forecast
         matches where the TV actually is rather than a hardcoded city. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Normal (install-time) permission: lets the top bar show whether the
         TV is on Wi-Fi, Ethernet, or offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Modern (non-sensitive) replacement for QUERY_ALL_PACKAGES: tells
         Android exactly which other apps we need to see — anything with
         a TV or phone/tablet launcher entry point — without requesting
         broad visibility into every package on the device. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MyTVLauncher"
        android:supportsRtl="true">

        <!-- Main home screen activity.
             The HOME + DEFAULT category combo is what lets Android TV
             offer this app as a selectable launcher. LEANBACK_LAUNCHER
             is what makes it show up correctly on Android TV at all. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyTVLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
